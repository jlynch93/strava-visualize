STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
# Public origin used for OAuth redirects (defaults to the request origin).
APP_BASE_URL=http://localhost:4173
# Optional. Defaults to APP_BASE_URL/auth/strava/callback.
# STRAVA_REDIRECT_URI=http://localhost:4173/auth/strava/callback
# Encrypts stored provider tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Locally, npm start creates one in .data/ if this is unset.
TOKEN_ENCRYPTION_KEY=
# Garmin Connect Developer Program (leave empty until Garmin approves the app).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Random string; Garmin posts activities to /webhooks/garmin/<this value>.
GARMIN_WEBHOOK_SECRET=
# Optional. Defaults to APP_BASE_URL/auth/garmin/callback.
# GARMIN_REDIRECT_URI=http://localhost:4173/auth/garmin/callback
OLLAMA_BASE_URL=https://ollama.jeer.rest
OLLAMA_MODEL=qwen3.5:0.8b
