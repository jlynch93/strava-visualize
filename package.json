{
  "name": "strava-visualize",
  "version": "0.1.0",
  "private": true,
  "description": "A local web dashboard for visualizing Strava running trends over time.",
  "scripts": {
    "build": "node scripts/build-assets.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "predeploy:pages": "npm run build",
    "deploy:pages": "wrangler pages deploy .build/public --project-name strava-visualize"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.151.3"
  }
}
