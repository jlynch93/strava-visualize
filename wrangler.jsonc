{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strava-visualize",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/auth/*"]
  },
  "ratelimits": [
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "1101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strava-visualize",
      "database_id": "85989f5f-4070-4383-aaff-345ba13e03ff",
      "migrations_dir": "migrations"
    }
  ]
}
