{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strava-visualize",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-09",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./.build/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/auth/*"]
  },
  "ratelimits": [{ "name": "ANALYSIS_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } }]
}
