{
  "name": "Runlore",
  "short_name": "Runlore",
  "description": "Every run adds to the story. Training trends, fitness and plans from Strava and Garmin.",
  "start_url": "/?source=app",
  "display": "standalone",
  "background_color": "#0d181c",
  "theme_color": "#0d181c",
  "icons": [
    {
      "src": "/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "id": "/",
  "scope": "/",
  "orientation": "portrait",
  "categories": [
    "health",
    "fitness",
    "sports"
  ],
  "shortcuts": [
    {
      "name": "Fitness",
      "url": "/#fitness",
      "icons": [
        {
          "src": "/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Plan",
      "url": "/#planning",
      "icons": [
        {
          "src": "/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Runs",
      "url": "/#runs",
      "icons": [
        {
          "src": "/brand/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
